// Foundation only (Session 2): generator + datasource, no models yet.
// Models are added per-module, one migration per module, starting in Session 3
// (User/RefreshToken/OtpCode/InviteCode) per docs/PROJECT_PLAN.md's phase order.
// Full target schema is specified in docs/DATA_MODEL.md.
//
// Prisma 7 note (discovered during Session 2, not in docs/TECH_DECISIONS.md's
// original research): the `prisma-client-js` generator is deprecated and
// `datasource.url` is no longer read from this file at all - both moved to
// prisma.config.ts + a driver adapter. See that file and src/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Session 3 (Phase 2 — Auth, RBAC, Users). Facility is pulled forward from its
// documented Phase 1 slot (docs/PROJECT_PLAN.md) because User.facilityId is a
// hard FK dependency on it — Prisma cannot create that foreign key against a
// table that doesn't exist yet. Only the schema/columns are added here; the
// GET /facilities/nearby endpoint, Haversine logic, and seed data stay
// NOT_STARTED / Phase 1 scope (see docs/PROGRESS.md Session 3 entry).
enum FacilityType {
  health_post
  phcc
  hospital
  birthing_centre
}

model Facility {
  id                String       @id
  name              String
  type              FacilityType
  hasBirthingCentre Boolean      @map("has_birthing_centre")
  phone             String?
  lat               Float
  lng               Float
  municipality      String

  users       User[]
  inviteCodes InviteCode[]
  visits      Visit[]

  @@map("facilities")
}

enum Role {
  patient
  provider
  fchv
  admin
}

// REQ-USER-001, REQ-AUTH-*
model User {
  id         String    @id @default(uuid())
  phone      String    @unique
  pinHash    String?   @map("pin_hash")
  role       Role      @default(patient)
  name       String
  facilityId String?   @map("facility_id")
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now()) @map("created_at")

  refreshTokens         RefreshToken[]
  inviteCodesUsed       InviteCode[]
  patientsOwned         Patient[]
  accessGrantsRedeemed  AccessGrant[]
  auditEntriesActed     AuditEntry[]
  visitsRecorded        Visit[]
  pregnanciesRegistered Pregnancy[]
  ancContactsRecorded   AncContact[]
  documentsUploaded     Document[]

  @@map("users")
}

// REQ-AUTH-011. @@index([userId]) added beyond backend.md's literal schema —
// needed to revoke all of a user's refresh tokens on PIN reset or a detected
// reuse, per docs/DATA_MODEL.md.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// REQ-AUTH-002/003/004. One live OTP per phone at a time, by design (PK on phone).
model OtpCode {
  phone     String   @id
  code      String
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)

  @@map("otp_codes")
}

// REQ-AUTH-008/013.
model InviteCode {
  code         String   @id
  role         Role
  facilityId   String   @map("facility_id")
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  usedByUserId String?  @map("used_by_user_id")
  usedByUser   User?    @relation(fields: [usedByUserId], references: [id], onDelete: Restrict)

  @@map("invite_codes")
}

// Session 4 (Phase 3 — Patients).
enum Sex {
  female
  male
  other
}

// REQ-PATIENT-011.
model Patient {
  id                    String   @id
  ownerUserId           String   @map("owner_user_id")
  owner                 User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  name                  String
  sex                   Sex
  dob                   DateTime @db.Date
  bloodGroup            String?  @map("blood_group")
  ward                  Int?
  municipality          String?
  allergies             Json     @default("[]")
  chronicConditions     Json     @default("[]") @map("chronic_conditions")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt @map("updated_at")
  deleted               Boolean  @default(false)

  accessGrants AccessGrant[]
  auditEntries AuditEntry[]
  visits       Visit[]
  reminders    Reminder[]
  pregnancies  Pregnancy[]
  documents    Document[]

  @@index([ownerUserId])
  @@index([updatedAt])
  @@map("patients")
}

// Pulled forward from its documented Phase 4 slot, same rationale as Session
// 3's Facility pull-forward: REQ-ROLE-003/004 (canReadPatient/canAppendPatient)
// are Patient-module requirements that cannot be real without this table.
// Only the schema is added - no /grants routes, QR token signing, or redeem
// flow (those stay Phase 4/NOT_STARTED). See docs/PROGRESS.md Session 4 entry.
enum GrantScope {
  read
  append
}

model AccessGrant {
  id               String     @id @default(uuid())
  patientId        String     @map("patient_id")
  patient          Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  scope            GrantScope
  tokenJti         String     @unique @map("token_jti")
  expiresAt        DateTime   @map("expires_at")
  redeemedByUserId String?    @map("redeemed_by_user_id")
  redeemedByUser   User?      @relation(fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  redeemedAt       DateTime?  @map("redeemed_at")
  accessUntil      DateTime?  @map("access_until")
  revokedAt        DateTime?  @map("revoked_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  // REQ-GRANT-012 (Tier 2): the printed fallback card - a 1-year-lived
  // token whose redemption additionally requires the patient's PIN
  // (backend.md A.7). Server-set only, never client-controlled directly.
  printed          Boolean    @default(false)

  @@index([patientId, redeemedByUserId, accessUntil])
  // Session 6 performance audit finding: REQ-ROLE-007's GET /patients list
  // query (modules/patients/service.ts's listPatients) filters AccessGrant
  // by redeemedByUserId/revokedAt/accessUntil WITHOUT patientId - the index
  // above can't serve that as an efficient range scan, since a B-tree
  // composite index only supports leftmost-prefix lookups and patientId is
  // its leading column. This second index leads with redeemedByUserId to
  // cover that actor-scoped access pattern.
  @@index([redeemedByUserId, revokedAt, accessUntil])
  @@map("access_grants")
}

// Pulled forward from its documented Phase 1 slot, same rationale as
// AccessGrant above - REQ-PATIENT-010 (GET audit) and REQ-ROLE-006
// (record_viewed throttle) need it directly. No routes.ts: audit is written
// by other modules' service code and read only via patients/routes.ts, per
// docs/ARCHITECTURE.md's directory tree. No `deleted` field - REQ-AUDIT-002
// requires audit rows to be immutable and undeletable, not merely
// soft-deletable.
enum AuditAction {
  grant_created
  grant_redeemed
  record_viewed
  visit_added
  contact_recorded
  document_added
  grant_revoked
}

model AuditEntry {
  id                String      @id @default(uuid())
  patientId         String      @map("patient_id")
  patient           Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  actorUserId       String      @map("actor_user_id")
  actorUser         User        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorName         String      @map("actor_name")
  actorFacilityName String?     @map("actor_facility_name")
  action            AuditAction
  grantId           String?     @map("grant_id")
  at                DateTime    @default(now())

  @@index([patientId, at])
  @@map("audit_entries")
}

// Session 7 (Phase 5 - Visits).

// Pulled forward from its documented Phase 1 slot, same rationale as every
// earlier pull-forward in this file: REQ-VISIT-004 ("codes validated against
// codelist, else 400") is a hard dependency of Visits. Only the schema and a
// working (non-exhaustive) seed of the codes this build actually exercises
// are added now - GET /codelists (REQ-CODELIST-001) and REQ-SEED-003's full
// 40/60/50-code demo target stay NOT_STARTED/partial. See
// docs/PROGRESS.md's Session 7 entry.
model CodeListItem {
  kind    String
  code    String
  labelEn String @map("label_en")
  labelNp String @map("label_np")
  meta    Json?

  @@id([kind, code])
  @@map("codelist_items")
}

enum ReminderKind {
  anc_due
  anc_missed
  follow_up
  medicine
}

enum Channel {
  sms
  push
}

enum ReminderStatus {
  pending
  sent
  failed
  cancelled
}

// Session 11 (Phase 8 - Reminders & SMS). `attempts` is not in backend.md's
// literal schema, but REQ-REMIND-003 ("retry next tick up to 3 times, then
// failed") is structurally impossible to implement correctly without a
// persisted counter - documented here rather than silently added.
model Reminder {
  id             String         @id @default(uuid())
  patientId      String         @map("patient_id")
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  pregnancyId    String?        @map("pregnancy_id")
  pregnancy      Pregnancy?     @relation(fields: [pregnancyId], references: [id], onDelete: Restrict)
  refId          String?        @map("ref_id")
  kind           ReminderKind
  dueAt          DateTime       @map("due_at")
  channel        Channel        @default(sms)
  recipientPhone String         @map("recipient_phone")
  recipientRole  String         @map("recipient_role")
  messageNp      String         @map("message_np")
  messageEn      String         @map("message_en")
  status         ReminderStatus @default(pending)
  attempts       Int            @default(0)
  sentAt         DateTime?      @map("sent_at")

  // REQ-REMIND-001: the worker's poll query (status=pending AND dueAt<=now).
  @@index([status, dueAt])
  @@index([patientId])
  @@map("reminders")
}

// REQ-REMIND-002/006. Demo-only table (docs/DATA_MODEL.md): no index beyond
// PK - GET /demo/sms reads the last 50 by sentAt, a small table by
// construction (only ever populated when SMS_MODE=mock).
model MockSms {
  id     String   @id @default(uuid())
  to     String
  text   String
  sentAt DateTime @default(now()) @map("sent_at")

  @@map("mock_sms")
}

// REQ-VISIT-001..009.
model Visit {
  id                 String    @id
  patientId          String    @map("patient_id")
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  providerUserId     String    @map("provider_user_id")
  providerUser       User      @relation(fields: [providerUserId], references: [id], onDelete: Restrict)
  providerName       String    @map("provider_name")
  facilityId         String?   @map("facility_id")
  facility           Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  facilityName       String?   @map("facility_name")
  visitAt            DateTime  @map("visit_at")
  chiefComplaintCode String    @map("chief_complaint_code")
  vitals             Json      @default("{}")
  diagnosisCodes     Json      @default("[]") @map("diagnosis_codes")
  notes              String?
  advice             String?
  followUpAt         DateTime? @db.Date @map("follow_up_at")
  referral           Json?
  prescriptions      Json      @default("[]")
  // Self-referential by convention, not an FK (docs/DATA_MODEL.md §5) - a
  // corrected visit may reference a visit id that predates this constraint
  // set, and nothing requires enforcing referential integrity on it.
  supersedesId       String?   @map("supersedes_id")
  version            Int       @default(1)
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deleted            Boolean   @default(false)

  @@index([patientId, visitAt])
  @@index([updatedAt])
  @@map("visits")
}

// Session 9 (Phase 7 - Maternal: Pregnancy, ANC, Triage). REQ-PREG-*, REQ-RULES-*.

enum PregStatus {
  active
  delivered
  ended
}

enum RiskLevel {
  normal
  high
}

model Pregnancy {
  id                 String     @id
  patientId          String     @map("patient_id")
  patient            Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  lmp                DateTime?  @db.Date
  edd                DateTime   @db.Date
  gravida            Int
  para               Int
  riskFactors        Json       @default("[]") @map("risk_factors")
  riskLevel          RiskLevel  @default(normal) @map("risk_level")
  status             PregStatus @default(active)
  birthPlan          Json?      @map("birth_plan")
  registeredByUserId String     @map("registered_by_user_id")
  registeredByUser   User       @relation(fields: [registeredByUserId], references: [id], onDelete: Restrict)
  version            Int        @default(1)
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deleted            Boolean    @default(false)

  contacts  AncContact[]
  delivery  Delivery?
  reminders Reminder[]

  @@index([patientId, status])
  @@index([updatedAt])
  @@map("pregnancies")
}

enum Triage {
  green
  amber
  red
}

// REQ-PREG-004/010, REQ-SYNC-023: id is deterministic (uuid v5), not
// client/server-generated at random, so an offline-created pregnancy's 8
// contacts never duplicate the server-generated set (src/lib/ids.ts).
model AncContact {
  id             String    @id
  pregnancyId    String    @map("pregnancy_id")
  pregnancy      Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Restrict)
  contactNo      Int       @map("contact_no")
  weekTarget     Int       @map("week_target")
  dueAt          DateTime  @db.Date @map("due_at")
  doneAt         DateTime? @map("done_at")
  providerUserId String?   @map("provider_user_id")
  providerUser   User?     @relation(fields: [providerUserId], references: [id], onDelete: Restrict)
  findings       Json?
  dangerSigns    Json      @default("[]") @map("danger_signs")
  triageLevel    Triage?   @map("triage_level")
  triageReasons  Json      @default("[]") @map("triage_reasons")
  referral       Json?
  version        Int       @default(1)
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deleted        Boolean   @default(false)

  @@unique([pregnancyId, contactNo])
  @@index([updatedAt])
  @@map("anc_contacts")
}

enum DeliveryPlace {
  home
  birthing_centre
  hospital
  on_the_way
}

enum DeliveryMode {
  normal
  assisted
  cs
}

enum Outcome {
  live_birth
  stillbirth
}

model Delivery {
  id            String        @id
  pregnancyId   String        @unique @map("pregnancy_id")
  pregnancy     Pregnancy     @relation(fields: [pregnancyId], references: [id], onDelete: Restrict)
  deliveredAt   DateTime      @map("delivered_at")
  place         DeliveryPlace
  mode          DeliveryMode
  outcome       Outcome
  babyWeightKg  Float?        @map("baby_weight_kg")
  babySex       Sex?          @map("baby_sex")
  complications Json          @default("[]")
  version       Int           @default(1)
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deleted       Boolean       @default(false)

  @@map("deliveries")
}

// Session 12 (Phase 6 - Sync). REQ-SYNC-002: de-dupes POST /sync/push
// changes by opId. No secondary index - opId lookups (the PK) are the only
// query pattern this table serves.
model SyncOp {
  opId       String   @id @map("op_id")
  deviceId   String   @map("device_id")
  userId     String   @map("user_id")
  status     String
  resultJson Json     @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("sync_ops")
}

// Session 13 (Phase 9 - Documents). REQ-DOC-001..008. `contentType` is
// always "image/jpeg" - Question 3 (docs/OPEN_QUESTIONS.md) resolved dropping
// PNG from the accepted list, since the frontend's only documented capture
// path already compresses to JPEG.
enum DocType {
  prescription
  lab
  discharge
  referral
  other
}

enum DocStatus {
  pending_upload
  uploaded
}

enum AiStatus {
  none
  queued
  done
  failed
}

model Document {
  id               String    @id
  patientId        String    @map("patient_id")
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  uploadedByUserId String    @map("uploaded_by_user_id")
  uploadedByUser   User      @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  type             DocType
  title            String
  takenAt          DateTime  @db.Date @map("taken_at")
  status           DocStatus @default(pending_upload)
  objectKey        String    @map("object_key")
  contentType      String    @map("content_type")
  // Phase 10 hardening (SECURITY.md row 15): the client-declared size at
  // presign time, kept so `completeDocument` can verify the real uploaded
  // object's Content-Length against it, not just trust the header.
  // `@default(0)` exists only to satisfy this migration against
  // already-existing rows (dev/demo data predating this field) -
  // `presignDocument` always sets a real value on every new document.
  declaredSizeBytes Int      @default(0) @map("declared_size_bytes")
  aiSummary        String?   @map("ai_summary")
  aiSummaryStatus  AiStatus  @default(none) @map("ai_summary_status")
  version          Int       @default(1)
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deleted          Boolean   @default(false)

  @@index([patientId])
  @@index([updatedAt])
  @@map("documents")
}
