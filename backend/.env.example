# Copy to .env and fill in real values for local development.
# Every key the app reads at startup must appear here with a dummy value (CLAUDE.md §7).

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://swc:swc@localhost:5432/swc
# A second, separate database used only by the test suite (docs/ARCHITECTURE.md §Foundation, Session 2 step 4).
TEST_DATABASE_URL=postgresql://swc:swc@localhost:5432/swc_test

REDIS_URL=redis://localhost:6379

# HS256 signing secrets — must be different from each other, 32+ random chars, never committed.
JWT_SECRET=dev-only-change-me-32-chars-minimum-000000
GRANT_SECRET=dev-only-change-me-different-secret-000000

ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=30d
GRANT_TTL_MIN_DEFAULT=10
GRANT_ACCESS_WINDOW_H=24

S3_ENDPOINT=http://localhost:9000
# Set this to the tunnel/public host when phones can't reach localhost:9000 (docs/TECH_DECISIONS.md's MinIO section).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=swc-docs
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

SMS_MODE=mock
SPARROW_TOKEN=
SPARROW_FROM=

# argon2id cost parameters (REQ-SEC-005). Defaults are the researched baseline
# in docs/TECH_DECISIONS.md; tune down for faster local dev if needed.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

OTP_MODE=demo
# REQ-DOC-007: set AI_MODE=on and a real ANTHROPIC_API_KEY to enable
# POST /documents/:id/summarize's actual vision-LLM worker. config.ts
# refuses to boot with AI_MODE=on and no key set.
AI_MODE=off
ANTHROPIC_API_KEY=

TZ_DISPLAY=Asia/Kathmandu
CORS_ORIGINS=*
LOG_LEVEL=info
